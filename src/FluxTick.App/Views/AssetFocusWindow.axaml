<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:FluxTick.App.Localization"
        xmlns:vm="using:FluxTick.App.ViewModels"
        xmlns:controls="using:FluxTick.App.Controls"
        x:Class="FluxTick.App.Views.AssetFocusWindow"
        x:DataType="vm:AssetRowViewModel"
        WindowDecorations="None"
        WindowState="FullScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBgBrush}"
        Title="FluxTick">

  <!-- One instrument on a window that fills the screen. It shares the row of the list, so it follows every tick. The text
       sizes come from the height of the window (AssetFocusRules), set by the code behind. Double-click or Esc closes it. -->
  <Grid Name="Root" Classes.stopped="{Binding IsDimmed}" Margin="48,36" RowDefinitions="Auto,Auto,*,Auto">

    <Grid Grid.Row="0">
      <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <TextBlock Name="NameText" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Name="SymbolText" Classes="muted" Text="{Binding Symbol}" VerticalAlignment="Center" />
        <Border Classes="chip" VerticalAlignment="Center" IsVisible="{Binding HasMarketBadge}">
          <TextBlock Text="{Binding MarketBadgeText}" Classes="muted" FontWeight="SemiBold" />
        </Border>
        <Border Classes="chip" VerticalAlignment="Center">
          <TextBlock Text="{Binding ClassLabel}" Classes="muted" FontWeight="SemiBold" />
        </Border>
        <TextBlock Name="ProviderText" Classes="muted" Text="{Binding ProviderName}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- The price, the change beside it (or the status when the price cannot be trusted), and the profit or loss. -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,12,0,0">
      <TextBlock Name="PriceText" Classes="mono" Classes.up="{Binding IsUp}" Classes.down="{Binding IsDown}"
                 Text="{Binding PriceText}" FontWeight="SemiBold" VerticalAlignment="Bottom" />
      <StackPanel Grid.Column="1" Margin="32,0,0,8" VerticalAlignment="Bottom" Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !HasStatus}">
          <Path Classes="arrow up" Data="M0 5L3 0L6 5Z" Stretch="Uniform" Width="20" Height="16" VerticalAlignment="Center" IsVisible="{Binding IsUp}" />
          <Path Classes="arrow down" Data="M0 0L6 0L3 5Z" Stretch="Uniform" Width="20" Height="16" VerticalAlignment="Center" IsVisible="{Binding IsDown}" />
          <TextBlock Name="ChangeText" Text="{Binding ChangeText}" Classes="mono" FontWeight="SemiBold"
                     Classes.up="{Binding IsUp}" Classes.down="{Binding IsDown}" />
          <TextBlock Name="AmountText" Text="{Binding ChangeAmountText}" Classes="mono muted" VerticalAlignment="Bottom"
                     Classes.up="{Binding IsUp}" Classes.down="{Binding IsDown}" />
        </StackPanel>
        <TextBlock Name="StatusText" Text="{Binding StatusText}" Classes="warn" Classes.muted="{Binding StatusIsNeutral}"
                   IsVisible="{Binding HasStatus}" />
        <TextBlock Name="BasisText" Classes="muted" Text="{Binding BasisText}"
                   IsVisible="{Binding BasisText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Grid>

    <controls:SparklineControl Grid.Row="2" Classes="chart" Margin="0,24"
                               ToolTip.Tip="{Binding ChartTip}"
                               ShowPercentAxis="True"
                               IsHoverEnabled="True"
                               HoverIndex="{Binding ChartHoverIndex, Mode=TwoWay}"
                               Points="{Binding Sparkline}"
                               Timeline="{Binding SparklineTimeline}"
                               AboveLevel="{Binding AlertAbove}"
                               BelowLevel="{Binding AlertBelow}"
                               Price="{Binding CurrentPrice}"
                               IsStopped="{Binding IsDimmed}"
                               Classes.up="{Binding IsRangeUp}"
                               Classes.down="{Binding IsRangeDown}" />

    <!-- The figures under the chart: the reference price, the range of the chart, and the holding when there is one. -->
    <Grid Grid.Row="3" ColumnDefinitions="*,*,*,*,*">
      <StackPanel>
        <TextBlock Classes="detail muted" Text="{Binding ReferenceLabel}" />
        <TextBlock Classes="detail mono" Text="{Binding ReferenceText}" />
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Classes="detail muted" Text="{Binding RangeLowLabel}" />
        <TextBlock Classes="detail mono" Text="{Binding LowText}" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Classes="detail muted" Text="{Binding RangeHighLabel}" />
        <TextBlock Classes="detail mono" Text="{Binding HighText}" />
      </StackPanel>
      <StackPanel Grid.Column="3" IsVisible="{Binding HasHolding}">
        <TextBlock Classes="detail muted" Text="{loc:T Row_Cost}" />
        <TextBlock Classes="detail mono" Text="{Binding CostPriceText}" />
      </StackPanel>
      <StackPanel Grid.Column="4" IsVisible="{Binding HasHolding}">
        <TextBlock Classes="detail muted" Text="{Binding HoldingText}" />
        <TextBlock Classes="detail mono" Text="{Binding PnlText}" Classes.up="{Binding IsProfit}" Classes.down="{Binding IsLoss}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
