<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:FluxTick.App.Localization"
        xmlns:vm="using:FluxTick.App.ViewModels"
        x:Class="FluxTick.App.Views.TrayPopupWindow"
        x:DataType="vm:TrayPopupViewModel"
        MinWidth="180"
        MaxWidth="320"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Title="FluxTick">

  <Window.Styles>
    <!-- The placeholder only shows while some listed row has a holding, otherwise no row has a column for it. -->
    <Style Selector="TextBlock.placeholder">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ItemsControl.holdings TextBlock.placeholder.noHolding">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Grid.stopped">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
  </Window.Styles>

  <Border Margin="6" Padding="10,8" CornerRadius="10" BorderThickness="1"
          Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
          BoxShadow="0 4 16 0 #55000000">
    <StackPanel Spacing="2">
      <TextBlock Text="{loc:T TrayPopup_Empty}" Classes="muted" IsVisible="{Binding IsEmpty}" Margin="0,4" />
      <!-- Every row has two lines in each column and the same height, with or without a holding, and the texts of a column
           are centered in it. The holding column shares its width between the rows: it has none while no instrument
           is held, and all rows keep their prices in line while one is. -->
      <ItemsControl ItemsSource="{Binding Items}" Grid.IsSharedSizeScope="True" Classes.holdings="{Binding HasAnyHolding}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AssetRowViewModel">
            <!-- Like the rows and cards of the window, an instrument whose prices stopped is dimmed and says why. -->
            <Grid MinHeight="40" Classes.stopped="{Binding IsDimmed}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Pnl" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Symbol}" Classes="muted mono" FontSize="10" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="{Binding PriceText}" Classes="mono" HorizontalAlignment="Right"
                           Classes.up="{Binding IsUp}" Classes.down="{Binding IsDown}" />
                <Panel MinWidth="64">
                  <TextBlock Text="{Binding ChangeText}" Classes="mono" FontSize="11" HorizontalAlignment="Right"
                             IsVisible="{Binding !HasStatus}"
                             Classes.up="{Binding IsUp}" Classes.down="{Binding IsDown}" />
                  <TextBlock Text="{Binding StatusText}" Classes="warn" Classes.muted="{Binding StatusIsNeutral}" FontSize="11" HorizontalAlignment="Right"
                             IsVisible="{Binding HasStatus}" />
                </Panel>
              </StackPanel>
              <!-- The profit or loss of the holding: the amount over the percent. -->
              <Grid Grid.Column="2" VerticalAlignment="Center">
                <StackPanel IsVisible="{Binding HasHolding}" Margin="10,0,0,0" ToolTip.Tip="{Binding PnlText}">
                  <TextBlock Text="{Binding PnlAmountText}" Classes="mono" HorizontalAlignment="Right"
                             Classes.up="{Binding IsProfit}" Classes.down="{Binding IsLoss}" />
                  <TextBlock Text="{Binding PnlPercentText}" Classes="mono" FontSize="11" HorizontalAlignment="Right"
                             Classes.up="{Binding IsProfit}" Classes.down="{Binding IsLoss}" />
                </StackPanel>
                <!-- A row without a holding fills the column while other rows have one, instead of leaving a gap. -->
                <TextBlock Classes="placeholder muted mono" Classes.noHolding="{Binding !HasHolding}" Text="—"
                           HorizontalAlignment="Center" Margin="10,0,0,0" />
              </Grid>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Height="1" Margin="0,4,0,0" Background="{DynamicResource BorderBrush}" IsVisible="{Binding HasPortfolio}" />
      <!-- The total of all holdings in the base currency. -->
      <TextBlock Text="{Binding PortfolioText}" IsVisible="{Binding HasPortfolio}" Classes="mono" FontSize="11" FontWeight="SemiBold"
                 HorizontalAlignment="Right" Margin="0,6,0,0"
                 Classes.up="{Binding PortfolioIsProfit}" Classes.down="{Binding PortfolioIsLoss}" />
      <!-- Where the tray icon has no menu (macOS), the entries of the menu are here. -->
      <StackPanel x:Name="MenuBar" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="14" Margin="0,8,0,0" IsVisible="False">
        <Button Classes="status" HorizontalAlignment="Right" Click="OnShowWindowClicked">
          <TextBlock Text="{loc:T Tray_ShowHide}" Classes="muted" FontSize="11" />
        </Button>
        <Button Classes="status" HorizontalAlignment="Right" Click="OnSettingsClicked">
          <TextBlock Text="{loc:T Tray_Settings}" Classes="muted" FontSize="11" />
        </Button>
        <Button Classes="status" HorizontalAlignment="Right" Click="OnExitClicked">
          <TextBlock Text="{loc:T Tray_Exit}" Classes="muted" FontSize="11" />
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
