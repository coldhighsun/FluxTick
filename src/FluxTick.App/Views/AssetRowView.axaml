<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:FluxTick.App.Localization"
             xmlns:vm="using:FluxTick.App.ViewModels"
             xmlns:controls="using:FluxTick.App.Controls"
             x:Class="FluxTick.App.Views.AssetRowView"
             x:DataType="vm:AssetRowViewModel">

  <!-- The tooltip is built when it opens, not for every price (see RowTooltip). -->
  <Border Name="TipHost" Classes="row" Classes.dimmed="{Binding IsDimmed}" ToolTip.Tip="{Binding TooltipContent}">
    <Grid ColumnDefinitions="*,Auto,Auto">

      <!-- Tick flash: briefly tints the row in the direction of the last move. -->
      <Border Name="Flash" Grid.ColumnSpan="3" CornerRadius="6" Opacity="0" IsHitTestVisible="False" Margin="-6,-4" />

      <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
        <!-- The name is the title and the symbol the subtitle. The name gives way (with an ellipsis) so that the class chip
             and the bell always stay in view. -->
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
          <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center" Margin="6,0,0,0">
            <TextBlock Text="{Binding ClassLabel}" Classes="muted" FontSize="9" FontWeight="SemiBold" />
          </Border>
          <!-- The trading state of the market, when it is not the regular session. -->
          <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center" Margin="4,0,0,0" IsVisible="{Binding HasMarketBadge}">
            <TextBlock Text="{Binding MarketBadgeText}" Classes="muted" FontSize="9" FontWeight="SemiBold" />
          </Border>
          <Path Grid.Column="3" Data="M5 1.5a2.5 2.5 0 0 0-2.5 2.5v2L1.5 8h7L7.5 6V4A2.5 2.5 0 0 0 5 1.5zM4 9.5a1 1 0 0 0 2 0" Stroke="{DynamicResource MutedBrush}"
                StrokeThickness="1" StrokeJoin="Round" Width="10" Height="11" Stretch="None" VerticalAlignment="Center" Margin="6,0,0,0"
                IsVisible="{Binding HasAlert}" ToolTip.Tip="{loc:T Row_AlertTip}" />
          <!-- The instrument is on the list the tray popup shows. -->
          <Path Grid.Column="4" Data="M1.5 1.5h7v7h-7zM3 4h4M3 6h3" Stroke="{DynamicResource MutedBrush}"
                StrokeThickness="1" StrokeJoin="Round" Width="10" Height="10" Stretch="None" VerticalAlignment="Center" Margin="6,0,0,0"
                IsVisible="{Binding ShowTrayMarker}" ToolTip.Tip="{loc:T Row_TrayTip}" />
        </Grid>
        <TextBlock Text="{Binding Symbol}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <controls:SparklineControl Grid.Column="1" Width="64" Height="26" Margin="8,0"
                                 ToolTip.Tip="{loc:T Row_SparklineTip}"
                                 IsVisible="{Binding ShowSparkline}"
                                 Points="{Binding Sparkline}"
                                 Timeline="{Binding SparklineTimeline}"
                                 AboveLevel="{Binding AlertAbove}"
                                 BelowLevel="{Binding AlertBelow}"
                                 Price="{Binding CurrentPrice}"
                                 IsStopped="{Binding IsStopped}"
                                 Classes.up="{Binding IsUp}"
                                 Classes.down="{Binding IsDown}" />

      <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="86" Spacing="1">
        <!-- The price rolls when it changes (see RowAnimator): the old number slides out of this clipped box while the new
             one slides in. PriceText is the real price and sizes the box; PriceOld lies over it and is only seen while it
             rolls. The transforms are elements, not strings, so that the animation has a TranslateTransform to change. -->
        <Grid HorizontalAlignment="Right" ClipToBounds="True">
          <TextBlock Name="PriceOld" Text="{Binding PreviousPriceText}" Classes="mono" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"
                     IsVisible="False" Opacity="0" IsHitTestVisible="False">
            <TextBlock.RenderTransform>
              <TranslateTransform />
            </TextBlock.RenderTransform>
          </TextBlock>
          <TextBlock Name="PriceText" Text="{Binding PriceText}" Classes="mono" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right">
            <TextBlock.RenderTransform>
              <TranslateTransform />
            </TextBlock.RenderTransform>
          </TextBlock>
        </Grid>
        <TextBlock Text="{Binding ChangeText}" IsVisible="{Binding !HasStatus}" Classes="mono"
                   Classes.up="{Binding IsUp}" Classes.down="{Binding IsDown}" FontSize="11" HorizontalAlignment="Right" />
        <TextBlock Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" Classes="warn" Classes.muted="{Binding StatusIsNeutral}" FontSize="11" HorizontalAlignment="Right" />
        <!-- The profit or loss of what the user holds of the instrument. -->
        <TextBlock Text="{Binding PnlText}" IsVisible="{Binding HasHolding}" Classes="mono" FontSize="10" HorizontalAlignment="Right"
                   ToolTip.Tip="{Binding HoldingText}" Classes.up="{Binding IsProfit}" Classes.down="{Binding IsLoss}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
