<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FluxTick.App.ViewModels"
        x:Class="FluxTick.App.Views.AlertToastWindow"
        x:DataType="vm:AlertToastViewModel"
        Width="300"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Cursor="Hand"
        Title="FluxTick">

  <Border Margin="6" Padding="12,10" CornerRadius="10" BorderThickness="1"
          Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
          BoxShadow="0 4 16 0 #55000000">
    <StackPanel Spacing="3">
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding Body}" Classes="muted mono" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</Window>
