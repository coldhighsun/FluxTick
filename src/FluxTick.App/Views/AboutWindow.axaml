<views:ToolWindow xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:loc="using:FluxTick.App.Localization"
                  xmlns:vm="using:FluxTick.App.ViewModels"
                  xmlns:views="using:FluxTick.App.Views"
                  x:Class="FluxTick.App.Views.AboutWindow"
                  x:DataType="vm:AboutViewModel"
                  Title="{loc:T About_WindowTitle}"
                  Icon="/Assets/fluxtick.png">

  <views:ToolWindowFrame Title="{loc:T About_WindowTitle}">
    <StackPanel Margin="14,14,14,12" Spacing="10">
      <Image Source="/Assets/fluxtick.png" Width="64" Height="64" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding Product}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="{loc:T Tagline}" Classes="muted" HorizontalAlignment="Center" />

      <Border Classes="card">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:T Update_CurrentVersion}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding VersionText}" Classes="muted mono" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:T About_Author}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Author}" Classes="muted" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:T About_License}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding License}" Classes="muted" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:T About_Homepage}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="link" Content="{Binding HomepageUrl}" Click="OnHomepageClick"
                    HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>
      <TextBlock Text="{loc:T Settings_Disclaimer}" Classes="muted" FontSize="10"
                 TextWrapping="Wrap" TextAlignment="Center" />
    </StackPanel>
  </views:ToolWindowFrame>
</views:ToolWindow>
