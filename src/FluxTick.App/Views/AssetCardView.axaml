<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:FluxTick.App.Localization"
             xmlns:vm="using:FluxTick.App.ViewModels"
             xmlns:controls="using:FluxTick.App.Controls"
             x:Class="FluxTick.App.Views.AssetCardView"
             x:DataType="vm:AssetRowViewModel">

  <!-- The size comes from the tile styles. Three sizes share this one layout: the small card shows only the symbol and
       the price (what the styles hide has the class "detail"), the large one also shows what has the class "largeonly".
       Nothing that the styles show or hide has a visibility of its own, as a value on the element would win. -->
  <Border Classes="tile" Classes.small="{Binding IsSmallCard}" Classes.large="{Binding IsLargeCard}" Classes.dimmed="{Binding IsDimmed}"
          ToolTip.Tip="{Binding Tooltip}">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

      <!-- Tick flash: briefly tints the card in the direction of the last move. Its margin is the padding of the card. -->
      <Border Name="Flash" Classes="flash" Grid.RowSpan="5" CornerRadius="6" Opacity="0" IsHitTestVisible="False" />

      <!-- The symbol gives way (with an ellipsis) so the class chip always stays inside the card. -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <TextBlock Classes="symbol" Text="{Binding Symbol}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Classes="detail" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="6,0,0,0">
          <Path Data="M5 1.5a2.5 2.5 0 0 0-2.5 2.5v2L1.5 8h7L7.5 6V4A2.5 2.5 0 0 0 5 1.5zM4 9.5a1 1 0 0 0 2 0" Stroke="{DynamicResource MutedBrush}"
            StrokeThickness="1" StrokeJoin="Round" Width="10" Height="11" Stretch="None" VerticalAlignment="Center"
            IsVisible="{Binding HasAlert}" ToolTip.Tip="{loc:T Row_AlertTip}" />
          <Border Classes="chip" VerticalAlignment="Center">
            <TextBlock Text="{Binding ClassLabel}" Classes="muted" FontSize="9" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Classes="detail" ColumnDefinitions="*,Auto">
        <TextBlock Classes="muted name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Classes="muted largeonly" Text="{Binding ProviderName}" FontSize="10" TextTrimming="CharacterEllipsis"
                   MaxWidth="110" Margin="6,0,0,0" VerticalAlignment="Center" />
      </Grid>

      <controls:SparklineControl Grid.Row="2" Classes="detail chart" Margin="0,4"
                                 ToolTip.Tip="{loc:T Row_SparklineTip}"
                                 Points="{Binding Sparkline}"
                                 Timeline="{Binding SparklineTimeline}"
                                 AboveLevel="{Binding AlertAbove}"
                                 BelowLevel="{Binding AlertBelow}"
                                 Price="{Binding CurrentPrice}"
                                 IsStopped="{Binding IsStopped}"
                                 Classes.up="{Binding IsUp}"
                                 Classes.down="{Binding IsDown}" />

      <!-- The price, and beside it the change (or the status when the price cannot be trusted). The small card has only the
           price; the large one adds the change in amount below the percent. -->
      <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
        <!-- The price rolls when it changes (see RowAnimator): the old number slides out of this clipped box while the new
             one slides in. PriceText is the real price and sizes the box; PriceOld lies over it and is only seen while it
             rolls. The transforms are elements, not strings, so that the animation has a TranslateTransform to change. -->
        <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom" ClipToBounds="True">
          <TextBlock Name="PriceOld" Classes="price mono" Classes.tickup="{Binding IsUp}" Classes.tickdown="{Binding IsDown}" Text="{Binding PreviousPriceText}"
                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis" IsVisible="False" Opacity="0" IsHitTestVisible="False">
            <TextBlock.RenderTransform>
              <TranslateTransform />
            </TextBlock.RenderTransform>
          </TextBlock>
          <TextBlock Name="PriceText" Classes="price mono" Classes.tickup="{Binding IsUp}" Classes.tickdown="{Binding IsDown}" Text="{Binding PriceText}"
                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
            <TextBlock.RenderTransform>
              <TranslateTransform />
            </TextBlock.RenderTransform>
          </TextBlock>
        </Grid>
        <StackPanel Grid.Column="1" Classes="detail" VerticalAlignment="Bottom" Margin="6,0,0,1">
          <TextBlock Text="{Binding ChangeText}" Classes="mono change" IsVisible="{Binding !HasStatus}" HorizontalAlignment="Right"
                     Classes.up="{Binding IsUp}" Classes.down="{Binding IsDown}" />
          <TextBlock Text="{Binding StatusText}" Classes="warn change" IsVisible="{Binding HasStatus}" HorizontalAlignment="Right" />
          <Panel Classes="largeonly">
            <TextBlock Text="{Binding ChangeAmountText}" Classes="mono muted" FontSize="11" IsVisible="{Binding !HasStatus}" HorizontalAlignment="Right"
                       Classes.up="{Binding IsUp}" Classes.down="{Binding IsDown}" />
          </Panel>
        </StackPanel>
      </Grid>

      <!-- Large card only: the reference price the change is measured against, and the range of the chart. -->
      <Grid Grid.Row="4" Classes="largeonly" ColumnDefinitions="*,*,*" Margin="0,8,0,0">
        <StackPanel>
          <TextBlock Text="{loc:T Row_Reference}" Classes="muted" FontSize="9" />
          <TextBlock Text="{Binding ReferenceText}" Classes="mono" FontSize="11" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{loc:T Row_RangeLow}" Classes="muted" FontSize="9" />
          <TextBlock Text="{Binding LowText}" Classes="mono" FontSize="11" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="{loc:T Row_RangeHigh}" Classes="muted" FontSize="9" />
          <TextBlock Text="{Binding HighText}" Classes="mono" FontSize="11" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
