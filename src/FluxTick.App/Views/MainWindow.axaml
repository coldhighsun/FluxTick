<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:FluxTick.App.Localization"
        xmlns:vm="using:FluxTick.App.ViewModels"
        xmlns:views="using:FluxTick.App.Views"
        xmlns:controls="using:FluxTick.App.Controls"
        xmlns:core="using:FluxTick.Core.Application"
        x:Class="FluxTick.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="FluxTick"
        Icon="/Assets/fluxtick.png"
        Height="440" MinHeight="180"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="True"
        Topmost="{Binding Settings.AlwaysOnTop}">

  <Grid>
    <!-- Background layer: only this layer is made translucent, text stays fully opaque. -->
    <Border Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Opacity="{Binding Settings.Opacity}" />

    <Grid Name="ContentGrid" RowDefinitions="Auto,*,Auto,Auto" Margin="{x:Static views:CardLayout.WindowFrameMargin}">

      <!-- Header: drag handle and actions -->
      <Border Grid.Row="0" Name="Header" Background="Transparent" Padding="14,8,8,4"
              PointerPressed="OnHeaderPointerPressed" PointerMoved="OnHeaderPointerMoved"
              PointerReleased="OnHeaderPointerReleased" PointerCaptureLost="OnHeaderPointerCaptureLost"
              DoubleTapped="OnHeaderDoubleTapped">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Image Source="/Assets/fluxtick.png" Width="16" Height="16" />
            <TextBlock Text="FluxTick" FontWeight="SemiBold" FontSize="13" />
          </StackPanel>

          <!-- The header holds up to nine buttons. Their width is set on each button (24 px instead of the 26 px of the
               icon style) because a value on the element always wins, so it fits the narrowest window widths for sure. -->
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Classes="icon" Width="24" ToolTip.Tip="{loc:T Add_Title}" Command="{Binding ShowAddCommand}">
              <Path Data="M7 2v10M2 7h10" />
            </Button>
            <Button Classes="icon" Width="24" ToolTip.Tip="{Binding LayoutToggleTip}" Command="{Binding ToggleLayoutCommand}" Classes.active="{Binding IsCardLayout}"
                    AutomationProperties.Name="{loc:T Main_ToggleLayoutAuto}">
              <Path Data="M2 2h4v4H2zM8 2h4v4H8zM2 8h4v4H2zM8 8h4v4H8z" />
            </Button>
            <Button Name="GroupButton" Classes="icon" Width="24" ToolTip.Tip="{loc:T Main_GroupCards}" IsVisible="{Binding IsCardLayout}" AutomationProperties.Name="{loc:T Main_GroupCards}">
              <Path Data="M2 2.5h4v3H2zM2 8.5h4v3H2zM8 4h4M8 10h4" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <!-- The grouping entries are added in code just before the flyout opens (see GroupingMenu). -->
                  <Separator IsVisible="{Binding IsCustomCardGrouping}" />
                  <MenuItem Header="{loc:T Main_NewGroup}" IsVisible="{Binding IsCustomCardGrouping}" Click="OnNewGroupClicked" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <!-- Three squares growing in size read as "card size"; a drop down picks small, medium or large. -->
            <Button Name="CardSizeButton" Classes="icon" Width="24" ToolTip.Tip="{loc:T Settings_CardSize}" IsVisible="{Binding IsCardLayout}"
                    AutomationProperties.Name="{loc:T Settings_CardSize}">
              <Path Data="M2 12V9.5h2.5V12zM6 12V6.5h2.5V12zM10 12V2.5h2.5V12z" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="{loc:T CardSize_Small}" ToggleType="Radio"
                            IsChecked="{Binding IsCardSizeSmall, Mode=OneWay}"
                            Command="{Binding SetCardSizeCommand}" CommandParameter="{x:Static core:CardSize.Small}" />
                  <MenuItem Header="{loc:T CardSize_Medium}" ToggleType="Radio"
                            IsChecked="{Binding IsCardSizeMedium, Mode=OneWay}"
                            Command="{Binding SetCardSizeCommand}" CommandParameter="{x:Static core:CardSize.Medium}" />
                  <MenuItem Header="{loc:T CardSize_Large}" ToggleType="Radio"
                            IsChecked="{Binding IsCardSizeLarge, Mode=OneWay}"
                            Command="{Binding SetCardSizeCommand}" CommandParameter="{x:Static core:CardSize.Large}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <!-- Four corners pointing out mean "fill the screen"; pointing in they mean "go back". Only the cards can fill the
                 screen, so the list has no such button (IsCardLayout is also true while the window is full screen). -->
            <Button Classes="icon" Width="24" IsVisible="{Binding IsCardLayout}" ToolTip.Tip="{Binding FullScreenTip}" Click="OnFullScreenClicked" Classes.active="{Binding IsFullScreen}"
                    AutomationProperties.Name="{loc:T Main_FullScreen}">
              <Panel>
                <Path Data="M2 5V2h3M9 2h3v3M12 9v3H9M5 12H2V9" IsVisible="{Binding !IsFullScreen}" />
                <Path Data="M5 2v3H2M9 2v3h3M12 9H9v3M2 9h3v3" IsVisible="{Binding IsFullScreen}" />
              </Panel>
            </Button>
            <!-- An arrow up to a bar at the top reads as "stay on top"; the padlock next to it is "lock position". -->
            <Button Classes="icon" Width="24" ToolTip.Tip="{loc:T Main_AlwaysOnTop}" Command="{Binding TogglePinCommand}" Classes.active="{Binding Settings.AlwaysOnTop}"
                    AutomationProperties.Name="{loc:T Main_AlwaysOnTop}">
              <Path Data="M3 2.5h8M7 12V5.5M4.5 8L7 5.5L9.5 8" />
            </Button>
            <Button Classes="icon" Width="24" ToolTip.Tip="{loc:T Settings_LockPosition}" Command="{Binding ToggleLockCommand}" Classes.active="{Binding Settings.Locked}"
                    AutomationProperties.Name="{loc:T Settings_LockPosition}">
              <Canvas Width="14" Height="14">
                <Path Data="M3.5 6.5h7v5.5h-7z" />
                <Path Data="M5 6.5V5a2 2 0 0 1 4 0v1.5" />
              </Canvas>
            </Button>
            <!-- A gear: eight teeth around a ring, with a hole in the middle. -->
            <Button Classes="icon" Width="24" ToolTip.Tip="{loc:T Main_Settings}" Command="{Binding ShowSettingsCommand}" Classes.active="{Binding IsSettingsOpen}"
                    AutomationProperties.Name="{loc:T Main_Settings}">
              <Canvas Width="14" Height="14">
                <Path Data="M5.70 2.48L6.01 0.78L7.99 0.78L8.30 2.48L9.28 2.89L10.70 1.90L12.10 3.30L11.11 4.72L11.52 5.70L13.22 6.01L13.22 7.99L11.52 8.30L11.11 9.28L12.10 10.70L10.70 12.10L9.28 11.11L8.30 11.52L7.99 13.22L6.01 13.22L5.70 11.52L4.72 11.11L3.30 12.10L1.90 10.70L2.89 9.28L2.48 8.30L0.78 7.99L0.78 6.01L2.48 5.70L2.89 4.72L1.90 3.30L3.30 1.90L4.72 2.89z" />
                <Ellipse Canvas.Left="5.2" Canvas.Top="5.2" Width="3.6" Height="3.6" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4" />
              </Canvas>
            </Button>
            <Button Classes="icon" Width="24" ToolTip.Tip="{Binding Settings.CloseButtonTip}" Click="OnCloseClicked">
              <Path Data="M3 3l8 8M11 3l-8 8" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Watchlist; settings and add instrument open in their own windows. -->
      <views:WatchlistView Name="Watchlist" Grid.Row="1" />

      <!-- The total profit or loss of all holdings, in the base currency. Shown only when there is a holding. -->
      <TextBlock Grid.Row="2" Text="{Binding PortfolioText}" IsVisible="{Binding HasPortfolio}" ToolTip.Tip="{Binding PortfolioTip}" Classes="mono" FontSize="11"
                 FontWeight="SemiBold" HorizontalAlignment="Right" Margin="14,4,14,0" TextTrimming="CharacterEllipsis"
                 Classes.up="{Binding PortfolioIsProfit}" Classes.down="{Binding PortfolioIsLoss}" />

      <!-- Footer: data source status and resize grip -->
      <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="14,2,4,6">
        <!-- Chips that do not fit are replaced by a "+N" badge; clicking the status opens the full list. -->
        <Button Name="StatusButton" Classes="status" AutomationProperties.Name="{loc:T Main_SourceStatus}">
          <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedLeft" FlyoutPresenterClasses="status">
              <Border Classes="card" Margin="0,0,0,4" MaxWidth="300">
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Chips}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProviderChipViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                          <Ellipse Classes="dot" Classes.good="{Binding IsGood}" Classes.bad="{Binding IsBad}"
                                   VerticalAlignment="Top" Margin="0,4,0,0" />
                          <TextBlock Text="{Binding Tooltip}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </Flyout>
          </Button.Flyout>
          <Grid>
            <controls:OverflowItemsControl Name="ChipsHost" ItemsSource="{Binding Chips}" VerticalAlignment="Center"
                                           Spacing="12" ReservedWidth="32">
              <controls:OverflowItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProviderChipViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="5" ToolTip.Tip="{Binding Tooltip}"
                              controls:OverflowPanel.HasProblem="{Binding IsBad}">
                    <Ellipse Classes="dot" Classes.good="{Binding IsGood}" Classes.bad="{Binding IsBad}" />
                    <TextBlock Text="{Binding Name}" Classes="muted" FontSize="11" />
                  </StackPanel>
                </DataTemplate>
              </controls:OverflowItemsControl.ItemTemplate>
            </controls:OverflowItemsControl>
            <Border Classes="chip" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="{Binding #ChipsHost.ReservedWidth}" IsVisible="{Binding #ChipsHost.HasHiddenItems}">
              <TextBlock HorizontalAlignment="Center" Text="{Binding #ChipsHost.HiddenCount, StringFormat='+{0}'}" Classes="muted"
                         Classes.warn="{Binding #ChipsHost.HiddenHasProblem}" FontSize="11" />
            </Border>
          </Grid>
        </Button>
        <!-- The list layout has a fixed width, so there the grip only resizes vertically. -->
        <Border Classes="grip" Classes.listLayout="{Binding !IsCardLayout}" Grid.Column="1" Width="16" Height="16" Background="Transparent"
                PointerPressed="OnResizeGripPressed">
          <!-- The cursor comes from styles: a value set on the element itself would always win over them. -->
          <Border.Styles>
            <Style Selector="Border.grip">
              <Setter Property="Cursor" Value="BottomRightCorner" />
            </Style>
            <Style Selector="Border.grip.listLayout">
              <Setter Property="Cursor" Value="SizeNorthSouth" />
            </Style>
          </Border.Styles>
          <Path Data="M12 4L4 12M12 8l-4 4" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2" StrokeLineCap="Round" />
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
