<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FluxTick.App.ViewModels"
        xmlns:views="using:FluxTick.App.Views"
        x:Class="FluxTick.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="FluxTick"
        Icon="/Assets/fluxtick.png"
        Width="340" Height="440" MinWidth="280" MinHeight="180"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="True"
        Topmost="{Binding Settings.AlwaysOnTop}">

  <Grid>
    <!-- Background layer: only this layer is made translucent, text stays fully opaque. -->
    <Border Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Opacity="{Binding Settings.Opacity}" />

    <Grid RowDefinitions="Auto,*,Auto" Margin="1">

      <!-- Header: drag handle and actions -->
      <Border Grid.Row="0" Name="Header" Background="Transparent" Padding="14,8,8,4"
              PointerPressed="OnHeaderPointerPressed" DoubleTapped="OnHeaderDoubleTapped">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Image Source="/Assets/fluxtick.png" Width="16" Height="16" />
            <TextBlock Text="FluxTick" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="{Binding AddAsset.Title}" IsVisible="{Binding IsAddPage}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="Settings" IsVisible="{Binding IsSettingsPage}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
            <Button Classes="icon" ToolTip.Tip="Back" Command="{Binding ShowWatchlistCommand}" IsVisible="{Binding !IsWatchlistPage}">
              <Path Data="M9 2L4 7l5 5" />
            </Button>
            <Button Classes="icon" ToolTip.Tip="Add instrument" Command="{Binding ShowAddCommand}" IsVisible="{Binding IsWatchlistPage}">
              <Path Data="M7 2v10M2 7h10" />
            </Button>
            <Button Classes="icon" ToolTip.Tip="Settings" Command="{Binding ShowSettingsCommand}" Classes.active="{Binding IsSettingsPage}">
              <Canvas Width="14" Height="14">
                <Path Data="M1 4h5M10 4h3M1 10h3M8 10h5" />
                <Ellipse Canvas.Left="6" Canvas.Top="2" Width="4" Height="4" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4" />
                <Ellipse Canvas.Left="4" Canvas.Top="8" Width="4" Height="4" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4" />
              </Canvas>
            </Button>
            <Button Classes="icon" ToolTip.Tip="Keep on top" Command="{Binding TogglePinCommand}" Classes.active="{Binding Settings.AlwaysOnTop}">
              <Path Data="M5 2h4l-.4 3.2L10.5 7v1H7.6v4h-1.2V8H3.5V7l1.9-1.8z" />
            </Button>
            <Button Classes="icon" ToolTip.Tip="Hide to tray" Click="OnHideClicked">
              <Path Data="M3 3l8 8M11 3l-8 8" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Pages -->
      <Grid Grid.Row="1">
        <views:WatchlistView IsVisible="{Binding IsWatchlistPage}" />
        <Grid IsVisible="{Binding IsAddPage}">
          <views:AddAssetView DataContext="{Binding AddAsset}" />
        </Grid>
        <Grid IsVisible="{Binding IsSettingsPage}">
          <views:SettingsView DataContext="{Binding Settings}" />
        </Grid>
      </Grid>

      <!-- Footer: data source status and resize grip -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="14,2,4,6">
        <ItemsControl ItemsSource="{Binding Chips}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProviderChipViewModel">
              <StackPanel Orientation="Horizontal" Spacing="5" ToolTip.Tip="{Binding Tooltip}">
                <Ellipse Classes="dot" Classes.good="{Binding IsGood}" Classes.bad="{Binding IsBad}" />
                <TextBlock Text="{Binding Name}" Classes="muted" FontSize="11" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Grid.Column="1" Width="16" Height="16" Background="Transparent" Cursor="BottomRightCorner"
                PointerPressed="OnResizeGripPressed">
          <Path Data="M12 4L4 12M12 8l-4 4" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2" StrokeLineCap="Round" />
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
