<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:FluxTick.App.Localization"
             x:Class="FluxTick.App.Views.NewGroupPlaceholder">

  <!-- The dashed "+ New group" placeholder of the settings page. -->
  <Button Name="Inner" HorizontalAlignment="Stretch" Padding="0" Background="Transparent" AutomationProperties.Name="{loc:T Group_NewTitle}">
    <Grid Height="34">
      <Rectangle RadiusX="8" RadiusY="8" StrokeThickness="1" StrokeDashArray="4,3" Stroke="{DynamicResource BorderBrush}" />
      <TextBlock Text="{loc:T Group_NewPlaceholder}" Classes="muted" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
  </Button>
</UserControl>
