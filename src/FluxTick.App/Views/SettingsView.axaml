<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:abs="using:FluxTick.Abstractions"
             xmlns:core="using:FluxTick.Core.Application"
             xmlns:vm="using:FluxTick.App.ViewModels"
             xmlns:views="using:FluxTick.App.Views"
             x:Class="FluxTick.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <Style Selector="Grid.dependent:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto" Margin="0,10,0,0">
    <TabControl Grid.Row="0" Classes="settings">

      <TabItem Header="Appearance">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,10,14,4">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Text="Opacity" VerticalAlignment="Center" />
                  <Slider Grid.Column="1" Minimum="0.3" Maximum="1" Value="{Binding Opacity}" Margin="12,0" />
                  <TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0:P0}}" Classes="muted mono" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Keep on top" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding AlwaysOnTop}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Compact" />
                    <TextBlock Text="Hides the charts; cards become smaller too" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding Compact}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Layout" />
                    <TextBlock Text="Cards wrap to fill the window width" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}" Width="140" />
                </Grid>
                <!-- Grouping only exists in the card layout, so the setting is unavailable (and dimmed) in the list layout. -->
                <Grid ColumnDefinitions="*,Auto" Classes="dependent" IsEnabled="{Binding IsCardLayoutSelected}">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Card grouping" />
                    <TextBlock Text="Only applies to the card layout" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Groupings}" SelectedItem="{Binding SelectedGrouping}" Width="140">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="core:CardGrouping">
                        <TextBlock Text="{Binding Converter={x:Static views:GroupingMenu.LabelConverter}}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Flash on price change" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding FlashOnUpdate}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Lock position" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding Locked}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Auto-hide at screen edge" />
                    <TextBlock Text="Needs Always on top. Drag the window to the left, right or top edge; point at the edge to bring it back" Classes="muted" FontSize="11" TextWrapping="Wrap"
                               IsVisible="{Binding AutoHideAvailable}" />
                    <TextBlock Text="Not available here: this system does not let a window be placed beyond the screen edge" Classes="muted" FontSize="11" TextWrapping="Wrap"
                               IsVisible="{Binding !AutoHideAvailable}" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoHideAtEdge}" IsEnabled="{Binding AutoHideAvailable}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Up / down colors" />
                    <TextBlock Text="Auto: red-up for Chinese UI" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding ColorConventions}" SelectedItem="{Binding SelectedColorConvention}" Width="140" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Groups">
        <ScrollViewer Name="GroupsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,10,14,4">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="Groups organize the cards in the card layout when grouping is set to Custom groups." Classes="muted" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <!-- Press and drag a row (its grip, or any part that is not the name box or a button) to reorder. -->
            <ItemsControl Name="GroupsList" ItemsSource="{Binding Groups.Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GroupItemViewModel">
                  <Border Classes="card" Padding="8,6" Cursor="SizeAll">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Path Data="M4 3h.01M4 7h.01M4 11h.01M9 3h.01M9 7h.01M9 11h.01" Stroke="{DynamicResource MutedBrush}"
                            StrokeThickness="2" StrokeLineCap="Round" Margin="2,0,10,0" VerticalAlignment="Center"
                            ToolTip.Tip="Drag to reorder" />
                      <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" MaxLength="40" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="IBeam" />
                      <Button Grid.Column="2" Classes="icon" Command="{Binding DeleteCommand}" AutomationProperties.Name="Delete group" Cursor="Arrow"
                              ToolTip.Tip="Delete group (its instruments move to the first remaining group)">
                        <Path Data="M3 3l8 8M11 3l-8 8" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- The same dashed placeholder as below the groups in the card layout; it asks for the name next to it. -->
            <views:NewGroupPlaceholder Name="NewGroupButton" Margin="0,6,0,6" Click="OnNewGroupClicked" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Data sources">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,10,14,4">
            <ItemsControl ItemsSource="{Binding Providers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProviderSettingsViewModel">
                  <Border Classes="card">
                    <StackPanel Spacing="6">
                      <!-- Header: click to expand or collapse; the enable switch stays outside the button. -->
                      <Grid ColumnDefinitions="*,Auto">
                        <ToggleButton Classes="disclosure" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding Name}">
                          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Path Classes="chevron" Classes.expanded="{Binding IsExpanded}" Data="M5 3l4 4-4 4" Width="14" Height="14" VerticalAlignment="Center" />
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                              <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Classes="dot" Classes.good="{Binding StatusGood}" Classes.bad="{Binding StatusBad}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="150"
                                           ToolTip.Tip="{Binding StatusText}" />
                                <TextBlock Text="· Check settings" Classes="warn" FontSize="11" IsVisible="{Binding HasOptionError}" />
                              </StackPanel>
                            </StackPanel>
                          </StackPanel>
                        </ToggleButton>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" />
                      </Grid>

                      <StackPanel Spacing="6" IsVisible="{Binding IsExpanded}">
                        <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="10" />

                        <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding Enabled}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OptionViewModel">
                              <StackPanel Spacing="3" Margin="0,6,0,0">
                                <TextBlock FontSize="11" Classes="muted">
                                  <Run Text="{Binding Label}" /><Run Text="{Binding Unit}" />
                                </TextBlock>
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" IsVisible="{Binding IsText}" PasswordChar="{Binding PasswordChar}" />
                                <ToggleSwitch IsChecked="{Binding BoolValue}" IsVisible="{Binding IsBool}" />
                                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" IsVisible="{Binding IsChoice}" HorizontalAlignment="Stretch" />
                                <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Error}" Classes="warn" FontSize="11" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Restore defaults" Command="{Binding RestoreDefaultsCommand}"
                                IsVisible="{Binding HasOptions}" HorizontalAlignment="Left" FontSize="11" Padding="10,4" Margin="0,6,0,0"
                                ToolTip.Tip="Put this source's options back to their built-in values (secret values such as keys are kept)" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Routing">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,10,14,4">
            <TextBlock Text="Default source per asset class" Classes="muted" FontSize="11" Margin="0,0,0,6" />
            <Border Classes="card">
              <ItemsControl ItemsSource="{Binding Routing}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RoutingRowViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding Selected}"
                                IsVisible="{Binding HasProviders}" Width="170">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="abs:ProviderDescriptor">
                            <TextBlock Text="{Binding DisplayName}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBlock Grid.Column="1" Text="No source enabled" IsVisible="{Binding !HasProviders}" Classes="warn" FontSize="11" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

    <StackPanel Grid.Row="1" Margin="14,4,14,0">
      <TextBlock Text="Every market. Every tick." Classes="muted" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,2" />
      <TextBlock Text="Market data may be delayed or inaccurate and is not investment advice." Classes="muted" FontSize="10"
                 TextWrapping="Wrap" TextAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
