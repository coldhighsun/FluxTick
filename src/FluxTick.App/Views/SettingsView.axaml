<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:FluxTick.App.Localization"
             xmlns:abs="using:FluxTick.Abstractions"
             xmlns:core="using:FluxTick.Core.Application"
             xmlns:vm="using:FluxTick.App.ViewModels"
             xmlns:views="using:FluxTick.App.Views"
             x:Class="FluxTick.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <Style Selector="Grid.dependent:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <!-- A data source row: the whole left part is one flat button. -->
    <Style Selector="Button.providerRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.providerRow:pointerover /template/ ContentPresenter, Button.providerRow:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.providerRow:pointerover Path.chevron">
      <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <!-- One compact row of the data source list: a button that opens the detail page, and the enable switch beside it. -->
    <DataTemplate x:Key="ProviderRowTemplate" x:DataType="vm:ProviderSettingsViewModel">
      <StackPanel>
      <TextBlock Text="{Binding SectionTitle}" Classes="section" Margin="2,6,0,6" IsVisible="{Binding HasSectionTitle}" />
      <Border Classes="card" Padding="8,6" Margin="0,0,0,6">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <Button Classes="providerRow" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Border Classes="chip warn" IsVisible="{Binding HasMissingRequired}" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Provider_NeedsSetup}" Classes="warn" FontSize="10" />
                  </Border>
                  <Border Classes="chip warn" IsVisible="{Binding HasOptionError}" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Settings_CheckSettings}" Classes="warn" FontSize="10" />
                  </Border>
                  <Border Classes="chip warn" IsVisible="{Binding IsDirty}" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Settings_Unsaved}" Classes="warn" FontSize="10" />
                  </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Classes="dot" Classes.good="{Binding StatusGood}" Classes.bad="{Binding StatusBad}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="150"
                             ToolTip.Tip="{Binding StatusText}" />
                  <TextBlock Text="·" Classes="muted" FontSize="11" />
                  <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                             ToolTip.Tip="{Binding Summary}" />
                </StackPanel>
              </StackPanel>
              <Path Grid.Column="1" Classes="chevron" Data="M5 3l4 4-4 4" Width="14" Height="14" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
        </Grid>
      </Border>
      </StackPanel>
    </DataTemplate>

    <!-- The editor of one option; the same for every type, with the editor of the option's type shown. -->
    <DataTemplate x:Key="OptionEditorTemplate" x:DataType="vm:OptionViewModel">
      <StackPanel Spacing="3" Margin="0,6,0,0">
        <TextBlock FontSize="11" Classes="muted">
          <Run Text="{Binding Label}" /><Run Text="{Binding Unit}" />
        </TextBlock>
        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsVisible="{Binding IsPlainText}" PasswordChar="{Binding PasswordChar}" />
        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsVisible="{Binding IsNumber}"
                 views:NumericInput.Enabled="True" views:NumericInput.Kind="{Binding NumberKind}" />
        <ToggleSwitch IsChecked="{Binding BoolValue}" IsVisible="{Binding IsBool}" />
        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" IsVisible="{Binding IsChoice}" HorizontalAlignment="Stretch" />
        <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Error}" Classes="warn" FontSize="11" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>


  <Grid RowDefinitions="*,Auto" Margin="0,10,0,0">
    <TabControl Grid.Row="0" Classes="settings" SelectedIndex="{Binding SelectedTabIndex}">

      <TabItem Header="{loc:T Settings_TabGeneral}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,10,14,4">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Settings_Language}" />
                    <TextBlock Text="{loc:T Settings_LanguageHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemTemplate="{DynamicResource EnumLabelTemplate}" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Width="140" />
                </Grid>
                <!-- Only Windows can register the app to start at sign-in. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding IsAutoStartSupported}">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Settings_LaunchAtLogin}" />
                    <TextBlock Text="{loc:T Settings_LaunchAtLoginHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchAtLogin}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Settings_StartMinimized}" />
                    <TextBlock Text="{loc:T Settings_StartMinimizedHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartMinimized}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Settings_CloseToTray}" />
                    <TextBlock Text="{loc:T Settings_CloseToTrayHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding CloseToTray}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding IsBossKeySupported}">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Settings_BossKey}" />
                    <TextBlock Text="{loc:T Settings_BossKeyHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <views:HotkeyBox Grid.Column="1" Value="{Binding BossKey}" EmptyText="{loc:T Settings_BossKeyNone}" RecordingText="{loc:T Settings_BossKeyPress}" IsCapturing="{Binding IsRecordingBossKey}" Width="140" VerticalAlignment="Center" AutomationProperties.Name="{loc:T Settings_BossKey}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Settings_BaseCurrency}" />
                    <TextBlock Text="{loc:T Settings_BaseCurrencyHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding BaseCurrencies}" SelectedItem="{Binding BaseCurrency}" Width="140" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <TextBlock Text="{loc:T Settings_KeepOnTop}" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding AlwaysOnTop}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <TextBlock Text="{loc:T Settings_LockPosition}" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding Locked}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding AutoHideSupported}">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Settings_AutoHide}" />
                    <TextBlock Text="{loc:T Settings_AutoHideHint}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                               IsVisible="{Binding AutoHideAvailable}" />
                    <TextBlock Text="{loc:T Settings_AutoHideUnavailable}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                               IsVisible="{Binding !AutoHideAvailable}" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoHideAtEdge}" IsVisible="{Binding AutoHideAvailable}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{loc:T Settings_TabAppearance}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,10,14,4">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Text="{loc:T Settings_Opacity}" VerticalAlignment="Center" />
                  <Slider Grid.Column="1" Minimum="0.3" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Opacity}" Margin="12,0" />
                  <TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0:P0}}" Classes="muted mono" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Settings_Layout}" />
                    <TextBlock Text="{loc:T Settings_LayoutHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemTemplate="{DynamicResource EnumLabelTemplate}" ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}" Width="140" />
                </Grid>
                <!-- Grouping only exists in the card layout, so the setting is unavailable (and dimmed) in the list layout. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Classes="dependent" IsEnabled="{Binding IsCardLayoutSelected}">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Settings_CardGrouping}" />
                    <TextBlock Text="{loc:T Settings_CardGroupingHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemTemplate="{DynamicResource EnumLabelTemplate}" ItemsSource="{Binding Groupings}" SelectedItem="{Binding SelectedGrouping}" Width="140" />
                </Grid>
                <!-- The size only exists in the card layout, like the grouping. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Classes="dependent" IsEnabled="{Binding IsCardLayoutSelected}">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Settings_CardSize}" />
                    <TextBlock Text="{loc:T Settings_CardSizeHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemTemplate="{DynamicResource EnumLabelTemplate}" ItemsSource="{Binding CardSizes}" SelectedItem="{Binding SelectedCardSize}" Width="140" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <TextBlock Text="{loc:T Settings_Roll}" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding RollPriceOnUpdate}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Settings_Theme}" />
                    <TextBlock Text="{loc:T Settings_ThemeHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemTemplate="{DynamicResource EnumLabelTemplate}" ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding SelectedThemeMode}" Width="140" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Settings_Font}" />
                    <TextBlock Text="{loc:T Settings_FontHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <!-- A text box with a list of the installed fonts below it. The list is filtered by what is typed; a click on a
                       font uses it, and an empty box is the font of the system. -->
                  <Panel Grid.Column="1" Width="140" VerticalAlignment="Center">
                    <TextBox Name="FontBox" Text="{Binding FontText}" PlaceholderText="{loc:T Settings_FontSystem}" AutomationProperties.Name="{loc:T Settings_Font}"
                             GotFocus="OnFontBoxGotFocus" LostFocus="OnFontBoxLostFocus" PointerReleased="OnFontBoxPointerReleased" KeyDown="OnFontBoxKeyDown" />
                    <Popup IsOpen="{Binding IsFontListOpen}" PlacementTarget="{Binding #FontBox}" Placement="Bottom" Width="140" IsLightDismissEnabled="True"
                           OverlayDismissEventPassThrough="True" Closed="OnFontListClosed">
                      <Border Classes="popuplist" Margin="0,4,0,0">
                        <ListBox Name="FontList" Classes="fontlist" ItemsSource="{Binding FontSuggestions}" Focusable="False" MaxHeight="240" />
                      </Border>
                    </Popup>
                  </Panel>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Settings_UpDownColors}" />
                    <TextBlock Text="{loc:T Settings_UpDownColorsHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemTemplate="{DynamicResource EnumLabelTemplate}" ItemsSource="{Binding ColorConventions}" SelectedItem="{Binding SelectedColorConvention}" Width="140" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{loc:T Settings_TabGroups}">
        <ScrollViewer Name="GroupsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,10,14,4">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="{loc:T Settings_GroupsHelp}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <!-- Press and drag a row (its grip, or any part that is not the name box or a button) to reorder. -->
            <ItemsControl Name="GroupsList" ItemsSource="{Binding Groups.Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GroupItemViewModel">
                  <Border Classes="card" Padding="8,6" Cursor="SizeAll">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Path Data="M4 3h.01M4 7h.01M4 11h.01M9 3h.01M9 7h.01M9 11h.01" Stroke="{DynamicResource MutedBrush}"
                            StrokeThickness="2" StrokeLineCap="Round" Margin="2,0,10,0" VerticalAlignment="Center"
                            ToolTip.Tip="{loc:T Settings_DragToReorder}" />
                      <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" MaxLength="40" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="IBeam" />
                      <Button Grid.Column="2" Classes="icon" Command="{Binding DeleteCommand}" AutomationProperties.Name="{loc:T Section_DeleteGroup}" Cursor="Arrow"
                              ToolTip.Tip="{loc:T Settings_DeleteGroupTip}">
                        <Path Data="M2 3.5h10M5.5 3.5V2h3v1.5M3.5 3.5l.6 8h5.8l.6-8M5.8 6v3.5M8.2 6v3.5" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- The dashed "New group" button; it asks for the name next to it. -->
            <views:NewGroupPlaceholder Name="NewGroupButton" Margin="0,6,0,6" Click="OnNewGroupClicked" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Only Windows lists instruments when the pointer rests on the tray icon. -->
      <TabItem Header="{loc:T Settings_TabTray}" IsVisible="{Binding IsTrayListSupported}">
        <ScrollViewer Name="TrayAssetsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,10,14,4">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding TrayAssetsHelp}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{loc:T Settings_TrayAssetsEmpty}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                           IsVisible="{Binding TrayAssets.IsEmpty}" />
              </StackPanel>
            </Border>
            <!-- Press and drag a row (any part that is not the remove button) to reorder. -->
            <ItemsControl Name="TrayAssetsList" ItemsSource="{Binding TrayAssets.Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TrayAssetItemViewModel">
                  <Border Classes="card" Padding="8,6" Cursor="SizeAll">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                      <Path Data="M4 3h.01M4 7h.01M4 11h.01M9 3h.01M9 7h.01M9 11h.01" Stroke="{DynamicResource MutedBrush}"
                            StrokeThickness="2" StrokeLineCap="Round" Margin="2,0,10,0" VerticalAlignment="Center"
                            ToolTip.Tip="{loc:T Settings_DragToReorder}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ProviderName}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Symbol}" Classes="muted mono" FontSize="11" VerticalAlignment="Center" Margin="8,0,6,0" />
                      <Button Grid.Column="3" Classes="icon" Command="{Binding RemoveCommand}" Cursor="Arrow"
                              AutomationProperties.Name="{loc:T Watch_RemoveFromTray}" ToolTip.Tip="{loc:T Watch_RemoveFromTray}">
                        <Path Data="M2 3.5h10M5.5 3.5V2h3v1.5M3.5 3.5l.6 8h5.8l.6-8M5.8 6v3.5M8.2 6v3.5" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{loc:T Settings_TabAlerts}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,10,14,4">
            <Border Classes="card">
              <TextBlock Text="{loc:T Settings_AlertsHelp}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </Border>
            <views:AlertRuleListView DataContext="{Binding Alerts}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{loc:T Settings_TabSources}">
        <Grid>
          <!-- The list: search, filters, a count, and one compact row per data source. A row opens the detail page. -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !IsProviderDetailOpen}">
            <StackPanel Margin="14,10,14,4">
              <TextBox Text="{Binding ProviderSearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:T Settings_SearchSources}"
                       AutomationProperties.Name="{loc:T Settings_SearchSources}" Margin="0,0,0,6" />
              <TextBlock Text="{Binding ProvidersSummary}" Classes="muted" FontSize="11" Margin="2,0,0,8" />

              <ItemsControl ItemsSource="{Binding ProviderStatusFilters}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProviderStatusFilterViewModel">
                    <ToggleButton Classes="filter" IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Label}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding ProviderClassFilters}" Margin="0,0,0,6">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProviderClassFilterViewModel">
                    <ToggleButton Classes="filter" IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Label}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{loc:T Settings_NoSourceMatches}" Classes="muted" HorizontalAlignment="Center" Margin="0,24"
                         IsVisible="{Binding HasNoProviderMatch}" />

              <ItemsControl ItemsSource="{Binding FilteredProviders}" ItemTemplate="{StaticResource ProviderRowTemplate}" />
            </StackPanel>
          </ScrollViewer>

          <!-- The detail page of the data source that was opened. Save and revert stay at the bottom, outside the scrolling area. -->
          <!-- The wrapper carries the visibility: the grid inside replaces the data context with the opened source. -->
          <Grid IsVisible="{Binding IsProviderDetailOpen}">
            <Grid RowDefinitions="Auto,*,Auto" DataContext="{Binding SelectedProvider}" x:DataType="vm:ProviderSettingsViewModel">
              <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="14,10,14,6">
                <Button Classes="outline" Command="{Binding $parent[views:SettingsView].((vm:SettingsViewModel)DataContext).CloseProviderDetailCommand}"
                        Padding="8,4" AutomationProperties.Name="{loc:T Settings_BackToSources}" ToolTip.Tip="{loc:T Settings_BackToSources}">
                  <Path Classes="chevron" Data="M9 3l-4 4 4 4" Width="14" Height="14" />
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Ellipse Classes="dot" Classes.good="{Binding StatusGood}" Classes.bad="{Binding StatusBad}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}" />
                  </StackPanel>
                </StackPanel>
                <ToggleSwitch Grid.Column="2" IsChecked="{Binding Enabled}" />
              </Grid>

              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14,4,14,8" Spacing="8">
                  <Border Classes="card">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <ItemsControl ItemsSource="{Binding AssetClassLabels}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <Border Classes="chip" Margin="0,0,4,0">
                                <TextBlock Text="{Binding}" FontSize="10" Classes="muted" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ModeLabel}" Classes="muted" FontSize="10" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasHomepage}">
                        <TextBlock Text="{loc:T Settings_Website}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                        <Button Classes="link" Content="{Binding HomepageHost}" Command="{Binding OpenHomepageCommand}" FontSize="11"
                                HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip.Tip="{Binding HomepageUrl}"
                                AutomationProperties.Name="{Binding HomepageHost}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Classes="card" IsVisible="{Binding HasBasicOptions}">
                    <ItemsControl ItemsSource="{Binding BasicOptions}" ItemTemplate="{StaticResource OptionEditorTemplate}" />
                  </Border>

                  <Border Classes="card" IsVisible="{Binding HasAdvancedOptions}">
                    <Expander Header="{loc:T Settings_AdvancedOptions}" IsExpanded="{Binding IsAdvancedExpanded, Mode=TwoWay}" Padding="0"
                              Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                      <!-- The built-in expander paints its own header and content; the card behind it is the surface. -->
                      <Expander.Resources>
                        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ExpanderHeaderBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
                      </Expander.Resources>
                      <ItemsControl ItemsSource="{Binding AdvancedOptions}" ItemTemplate="{StaticResource OptionEditorTemplate}" />
                    </Expander>
                  </Border>

                  <TextBlock Text="{loc:T Settings_NoOptions}" Classes="muted" FontSize="11" HorizontalAlignment="Center" Margin="0,8"
                             IsVisible="{Binding !HasOptions}" />
                </StackPanel>
              </ScrollViewer>

              <!-- Save and revert show while there are edits; restore defaults is always there. -->
              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="14,4,14,8" IsVisible="{Binding HasOptions}">
                <Button Classes="primary" Content="{loc:T Settings_Save}" Command="{Binding SaveCommand}" IsVisible="{Binding IsDirty}"
                        FontSize="11" Padding="12,4" />
                <Button Classes="outline" Content="{loc:T Settings_Revert}" Command="{Binding RevertCommand}" IsVisible="{Binding IsDirty}"
                        FontSize="11" Padding="10,4" />
                <Button Classes="outline" Content="{loc:T Settings_RestoreDefaults}" Command="{Binding RestoreDefaultsCommand}"
                        FontSize="11" Padding="10,4" ToolTip.Tip="{loc:T Settings_RestoreDefaultsTip}" />
                <TextBlock Text="{loc:T Settings_Unsaved}" Classes="muted" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding IsDirty}" />
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="{loc:T Settings_TabAbout}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,10,14,4">
            <!-- The hero, a compact strip in the middle: the icon with the name of the app over its version in a pill; the tag
                 line is in the footer of the window. -->
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" Margin="0,2,0,12">
              <Image Source="/Assets/fluxtick.png" Width="72" Height="72" VerticalAlignment="Center" />
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding About.Product}" FontSize="20" FontWeight="SemiBold" />
                <Border Classes="chip" HorizontalAlignment="Left" Padding="8,2"
                        IsVisible="{Binding Updates, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Text="{Binding Updates.CurrentVersionText}" Classes="muted mono" FontSize="11" />
                </Border>
              </StackPanel>
            </StackPanel>
            <Border Classes="card" Padding="12,4" Margin="0,0,0,4">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,8">
                  <TextBlock Text="{loc:T About_Author}" Classes="muted" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding About.Author}" VerticalAlignment="Center" />
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderBrush}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,8">
                  <TextBlock Text="{loc:T About_License}" Classes="muted" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding About.License}" VerticalAlignment="Center" />
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderBrush}" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="0,4">
                  <TextBlock Text="{loc:T About_Homepage}" Classes="muted" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="link" Content="{Binding About.HomepageUrl}" Command="{Binding OpenProjectHomepageCommand}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock Text="{loc:T Settings_OpenHomepageFailed}" Classes="warn" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,8"
                       IsVisible="{Binding HomepageOpenFailed}" />
            <!-- The update section has its own view model, which is none when the page has no updates. -->
            <Border Classes="card" Padding="12" Margin="0,8,0,8" DataContext="{Binding Updates}" x:DataType="vm:UpdateViewModel"
                    IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Spacing="10">
                <TextBlock Text="{loc:T About_UpdatesHeader}" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Update_AutoCheck}" />
                    <TextBlock Text="{loc:T Update_AutoCheckHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCheck}" />
                </Grid>
                <!-- The buttons first, and the status under them on a line of its own, which takes no room while it is empty. -->
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="outline" Content="{loc:T Update_Check}" Command="{Binding CheckCommand}" IsEnabled="{Binding CanCheck}" IsVisible="{Binding ShowCheck}" />
                    <Button Classes="primary" Content="{loc:T Update_UpdateNow}" Command="{Binding UpdateNowCommand}" IsVisible="{Binding CanUpdateNow}" />
                    <Button Classes="primary" Content="{loc:T Update_Download}" Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}" />
                    <Button Classes="outline" Content="{loc:T Update_OpenFolder}" Command="{Binding OpenFolderCommand}" IsVisible="{Binding IsDownloaded}" />
                  </StackPanel>
                  <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                             IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <TextBlock Text="{loc:T Update_ReleaseNotes}" FontWeight="SemiBold" VerticalAlignment="Center"
                             IsVisible="{Binding HasReleaseNotes}" />
                  <Button Grid.Column="1" Classes="link" Content="{loc:T Update_OpenReleasePage}" FontSize="11"
                          Command="{Binding OpenReleasePageCommand}" IsVisible="{Binding HasReleasePage}" />
                </Grid>
                <TextBox Text="{Binding ReleaseNotes, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="160" FontSize="11" IsVisible="{Binding HasReleaseNotes}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
              </StackPanel>
            </Border>
            <!-- Where the data is kept: the two folder buttons side by side in a card of their own. -->
            <Border Classes="card" Padding="12" Margin="0,0,0,8">
              <StackPanel Spacing="10">
                <TextBlock Text="{loc:T About_DataHeader}" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Classes="outline" Content="{loc:T Settings_OpenSettingsFolder}" Command="{Binding OpenSettingsFolderCommand}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  <Button Grid.Column="1" Classes="outline" Content="{loc:T Settings_OpenLogFolder}" Command="{Binding OpenLogFolderCommand}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </Grid>
                <TextBlock Text="{loc:T Settings_OpenFolderFailed}" Classes="warn" FontSize="11" TextWrapping="Wrap"
                           IsVisible="{Binding FolderOpenFailed}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

    <StackPanel Grid.Row="1" Margin="14,4,14,12">
      <TextBlock Text="{loc:T Tagline}" Classes="muted" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,2" />
      <TextBlock Text="{loc:T Settings_Disclaimer}" Classes="muted" FontSize="10"
                 TextWrapping="Wrap" TextAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
