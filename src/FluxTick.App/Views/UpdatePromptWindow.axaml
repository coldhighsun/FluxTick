<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FluxTick.App.ViewModels"
        xmlns:loc="using:FluxTick.App.Localization"
        x:Class="FluxTick.App.Views.UpdatePromptWindow"
        x:DataType="vm:UpdateViewModel"
        Width="320"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Title="FluxTick">

  <Border Margin="6" Padding="14,12" CornerRadius="10" BorderThickness="1"
          Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
          BoxShadow="0 4 16 0 #55000000">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding PromptTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="outline" Content="{loc:T Update_Later}" Click="OnLaterClick" />
        <Button Classes="outline" Content="{loc:T Update_UpdateNow}" Command="{Binding UpdateNowCommand}"
                IsEnabled="{Binding CanUpdateNow}" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
