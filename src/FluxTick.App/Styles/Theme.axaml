<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:FluxTick.App.Localization"
        xmlns:controls="using:FluxTick.App.Controls"
        xmlns:views="using:FluxTick.App.Views"
        xmlns:vm="using:FluxTick.App.ViewModels">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="WindowBgColor">#0B0D10</Color>
          <Color x:Key="SurfaceColor">#151A22</Color>
          <Color x:Key="SurfaceHoverColor">#1C232D</Color>
          <Color x:Key="BorderColor">#252D39</Color>
          <Color x:Key="ControlBorderColor">#445062</Color>
          <Color x:Key="PopupBgColor">#0E1116</Color>
          <Color x:Key="TextColor">#E6EDF3</Color>
          <Color x:Key="MutedColor">#7D8590</Color>
          <Color x:Key="AccentColor">#2EE59D</Color>
          <Color x:Key="WarnColor">#F5B94A</Color>
          <Color x:Key="GainColor">#2EE59D</Color>
          <Color x:Key="LossColor">#FF5C7A</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="WindowBgColor">#F6F8FA</Color>
          <Color x:Key="SurfaceColor">#FFFFFF</Color>
          <Color x:Key="SurfaceHoverColor">#EEF1F4</Color>
          <Color x:Key="BorderColor">#D0D7DE</Color>
          <Color x:Key="ControlBorderColor">#C2CAD3</Color>
          <Color x:Key="PopupBgColor">#FFFFFF</Color>
          <Color x:Key="TextColor">#1F2328</Color>
          <Color x:Key="MutedColor">#656D76</Color>
          <Color x:Key="AccentColor">#12A66D</Color>
          <Color x:Key="WarnColor">#B7791F</Color>
          <Color x:Key="GainColor">#12A66D</Color>
          <Color x:Key="LossColor">#E0405E</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <SolidColorBrush x:Key="WindowBgBrush" Color="{DynamicResource WindowBgColor}" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
      <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{DynamicResource SurfaceHoverColor}" />
      <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
      <SolidColorBrush x:Key="ControlBorderBrush" Color="{DynamicResource ControlBorderColor}" />
      <SolidColorBrush x:Key="PopupBgBrush" Color="{DynamicResource PopupBgColor}" />
      <!-- The built-in drop-down colors, replaced here as well as in the style below so that the pop-up cannot fall back to
           the theme's gray whichever of the two reaches it. -->
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource PopupBgColor}" />
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{DynamicResource ControlBorderColor}" />
      <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
      <SolidColorBrush x:Key="MutedBrush" Color="{DynamicResource MutedColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
      <SolidColorBrush x:Key="WarnBrush" Color="{DynamicResource WarnColor}" />
      <!-- The font of the interface text; App.ApplyFont() replaces it with the one of the settings. -->
      <FontFamily x:Key="UiFont">$Default</FontFamily>
      <!-- An entry of the sort menus, which the header menu and the context menu of the list both build from the same list. -->
      <ControlTheme x:Key="SortMenuItemTheme" x:DataType="vm:SortOptionViewModel" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Header" Value="{Binding Text}" />
        <Setter Property="ToggleType" Value="Radio" />
        <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
        <Setter Property="Command" Value="{Binding ChooseCommand}" />
        <Setter Property="ToolTip.Tip" Value="{Binding Tip}" />
        <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector=":is(TopLevel)">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <!-- Figures of the same width, so that a changing price does not shift: the font of the text, with its tabular figures
         when it has them (Maple Mono has equal widths anyway). -->
    <Setter Property="FontFeatures" Value="tnum" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,14,0,6" />
  </Style>
  <Style Selector="TextBlock.warn">
    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
  </Style>
  <!-- A status that is no fault, such as a market that is shut, is not drawn as a warning. -->
  <Style Selector="TextBlock.warn.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.up">
    <Setter Property="Foreground" Value="{DynamicResource UpBrush}" />
  </Style>
  <Style Selector="TextBlock.down">
    <Setter Property="Foreground" Value="{DynamicResource DownBrush}" />
  </Style>

  <Style Selector="controls|SparklineControl">
    <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    <Setter Property="StoppedStroke" Value="{DynamicResource MutedBrush}" />
    <Setter Property="AboveStroke" Value="{DynamicResource UpBrush}" />
    <Setter Property="BelowStroke" Value="{DynamicResource DownBrush}" />
  </Style>
  <Style Selector="controls|SparklineControl.up">
    <Setter Property="Stroke" Value="{DynamicResource UpBrush}" />
  </Style>
  <Style Selector="controls|SparklineControl.down">
    <Setter Property="Stroke" Value="{DynamicResource DownBrush}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="Button.icon Path">
    <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Button.icon:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.icon.active Path">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button.status">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.status:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.status:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.status:flyout-open /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.status:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.link /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextBlock.TextDecorations" Value="Underline" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="Button.link:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="FlyoutPresenter.status">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="ToggleButton.disclosure">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ToggleButton.disclosure:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.disclosure:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.disclosure:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.disclosure:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Path.chevron">
    <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
  </Style>
  <Style Selector="Path.chevron.expanded">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>
  <Style Selector="ToggleButton.disclosure:pointerover Path.chevron">
    <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="#0B0D10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- Text buttons without a fill: a thin border and the same rounding as the primary button. Opt-in, because some
       buttons (the search result rows, the new group placeholder) wrap their own look. -->
  <Style Selector="Button.outline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.outline:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
  </Style>
  <Style Selector="Button.outline:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>

  <!-- Text boxes: the same border and rounding as the buttons and drop-down lists. The border sits on a template part. The
       built-in focused look thickens the border to 2px and changes the fill, which shifts the text, so both are set again. -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <!-- The hotkey box looks like a text box: a thin border, the accent color while it has the focus, a light fill under the
       pointer. -->
  <Style Selector="views|HotkeyBox">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
  </Style>
  <Style Selector="views|HotkeyBox:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="views|HotkeyBox:focus">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
  </Style>

  <!-- The pop-up list of the font box: the same border, fill and rounding as the pop-up of a drop-down list. -->
  <Style Selector="Border.popuplist">
    <Setter Property="Background" Value="{DynamicResource PopupBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="ListBox.fontlist">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.fontlist ListBoxItem">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.fontlist ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- Drop-down lists: the same border and rounding as the outline buttons. The border and fill sit on template parts, so
       the states are spelled out on them; the pop-up has its own border and the items their own rounding. -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,5,0,5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background, ComboBox:pressed /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ PathIcon#DropDownGlyph, ComboBox:dropdownopen /template/ PathIcon#DropDownGlyph">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ComboBox:dropdownopen /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <!-- The keyboard focus ring: the built-in one fills the box with its own color, which would hide the hover fill. -->
  <Style Selector="ComboBox:focus-visible /template/ Border#HighlightBackground">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ComboBox:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="ComboBox /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource PopupBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- The built-in selected look fills the item with the accent color; every selected state is spelled out so that the
       selection is shown by the text color only. -->
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter, ComboBoxItem:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter, ComboBoxItem:selected:pointerover /template/ ContentPresenter, ComboBoxItem:selected:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter, ComboBoxItem:selected:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style Selector="ToggleButton.filter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ToggleButton.filter:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <!-- The built-in checked look fills the button with the accent color, which would hide text in that color, so every
       checked state is spelled out. -->
  <Style Selector="ToggleButton.filter:checked /template/ ContentPresenter, ToggleButton.filter:checked:pointerover /template/ ContentPresenter, ToggleButton.filter:checked:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ToggleButton.filter:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="4,1" />
  </Style>
  <!-- A chip that warns about the data (stale, delayed) is outlined, so that it stands out from the chips of a market state. -->
  <Style Selector="Border.chip.warn">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
    <Setter Property="Padding" Value="3,0" />
  </Style>

  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Ellipse.dot.good">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Ellipse.dot.bad">
    <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
  </Style>

  <Style Selector="Border.row">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="UserControl.dragging Border.row">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Border.row.dimmed > Grid">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- Cards of the card layout. The size is fixed and set by the card size setting: small (the symbol and the price only),
       medium (the base style) and large (a taller chart and more figures). What the small card leaves out has the class
       "detail", what only the large card shows has "largeonly" and what only the small one shows has "smallonly"; the visibility is set here, never on the elements. -->
  <Style Selector="Border.tile">
    <Setter Property="Width" Value="176" />
    <Setter Property="Height" Value="{x:Static views:CardLayout.MediumCardHeight}" />
    <Setter Property="Margin" Value="{x:Static views:CardLayout.CardMarginThickness}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="Border.tile.small">
    <Setter Property="Width" Value="128" />
    <Setter Property="Height" Value="{x:Static views:CardLayout.SmallCardHeight}" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="Border.tile.large">
    <Setter Property="Width" Value="{x:Static views:CardLayout.LargeCardWidth}" />
    <Setter Property="Height" Value="{x:Static views:CardLayout.LargeCardHeight}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.tile Border.flash">
    <Setter Property="Margin" Value="-10,-8" />
  </Style>
  <Style Selector="Border.tile.small Border.flash">
    <Setter Property="Margin" Value="-10,-7" />
  </Style>
  <Style Selector="Border.tile.large Border.flash">
    <Setter Property="Margin" Value="-12,-10" />
  </Style>
  <Style Selector="Border.tile TextBlock.symbol">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Border.tile.large TextBlock.symbol">
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="Border.tile TextBlock.name">
    <Setter Property="FontSize" Value="10" />
  </Style>
  <Style Selector="Border.tile.large TextBlock.name">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Border.tile TextBlock.price">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Border.tile.large TextBlock.price">
    <Setter Property="FontSize" Value="22" />
  </Style>
  <Style Selector="Border.tile TextBlock.change">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Border.tile.large TextBlock.change">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <!-- The price takes the color of the move where the change is not shown beside it. -->
  <Style Selector="Border.tile.small TextBlock.price.tickup, Border.tile.large TextBlock.price.tickup">
    <Setter Property="Foreground" Value="{DynamicResource UpBrush}" />
  </Style>
  <Style Selector="Border.tile.small TextBlock.price.tickdown, Border.tile.large TextBlock.price.tickdown">
    <Setter Property="Foreground" Value="{DynamicResource DownBrush}" />
  </Style>
  <Style Selector="Border.tile controls|SparklineControl.chart">
    <Setter Property="MinHeight" Value="16" />
  </Style>
  <Style Selector="Border.tile.large controls|SparklineControl.chart">
    <Setter Property="MinHeight" Value="44" />
  </Style>
  <Style Selector="Border.tile:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="Border.tile.dimmed > Grid">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="Border.tile.small :is(Control).detail">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.tile:not(.large) :is(Control).largeonly">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.tile:not(.small) :is(Control).smallonly">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="UserControl.dragging Border.tile">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
  </Style>

  <!-- The frame of the settings and add windows; it replaces the system title bar and matches the main window. -->
  <Style Selector="views|ToolWindowFrame">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border Background="{DynamicResource WindowBgBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="12" />
          <Grid RowDefinitions="Auto,*,Auto" Margin="1">
            <Border Name="PART_Header" Grid.Row="0" Background="Transparent" Padding="14,8,8,4">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Image Source="/Assets/fluxtick.png" Width="16" Height="16" />
                  <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <Button Name="PART_Close" Grid.Column="1" Classes="icon"
                        AutomationProperties.Name="{loc:T Common_Close}" ToolTip.Tip="{loc:T Common_CloseEsc}">
                  <Path Data="M3 3l8 8M11 3l-8 8" />
                </Button>
              </Grid>
            </Border>
            <ContentPresenter Grid.Row="1"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
            <!-- Its own row, so the grip never covers the content or its scroll bar. -->
            <Border Name="PART_Grip" Grid.Row="2" Width="16" Height="16" Margin="0,0,4,4"
                    HorizontalAlignment="Right"
                    Background="Transparent" Cursor="BottomRightCorner">
              <Path Data="M12 4L4 12M12 8l-4 4" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2" StrokeLineCap="Round" />
            </Border>
          </Grid>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="TabControl.settings">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TabControl.settings /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="Margin" Value="14,0" />
  </Style>
  <Style Selector="TabControl.settings > TabItem">
    <Setter Property="Padding" Value="8,6,8,8" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_LayoutRoot"
                Background="{TemplateBinding Background}"
                BorderBrush="Transparent"
                BorderThickness="0,0,0,2"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            RecognizesAccessKey="True" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TabControl.settings > TabItem:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TabControl.settings > TabItem:focus-visible /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="TabControl.settings > TabItem:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="TabControl.settings > TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TabControl.settings > TabItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <!-- A menu a pixel too tall for its pop-up window, as on a 150% screen, would show scroll arrows for that pixel.
       Menus are short, so none of them scrolls. -->
  <Style Selector="ContextMenu /template/ ScrollViewer, MenuFlyoutPresenter /template/ ScrollViewer, MenuItem /template/ ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
  </Style>
</Styles>
