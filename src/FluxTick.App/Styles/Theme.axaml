<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:FluxTick.App.Localization"
        xmlns:controls="using:FluxTick.App.Controls"
        xmlns:views="using:FluxTick.App.Views">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="WindowBgColor">#0B0D10</Color>
          <Color x:Key="SurfaceColor">#151A22</Color>
          <Color x:Key="SurfaceHoverColor">#1C232D</Color>
          <Color x:Key="BorderColor">#252D39</Color>
          <Color x:Key="TextColor">#E6EDF3</Color>
          <Color x:Key="MutedColor">#7D8590</Color>
          <Color x:Key="AccentColor">#2EE59D</Color>
          <Color x:Key="WarnColor">#F5B94A</Color>
          <Color x:Key="GainColor">#2EE59D</Color>
          <Color x:Key="LossColor">#FF5C7A</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="WindowBgColor">#F6F8FA</Color>
          <Color x:Key="SurfaceColor">#FFFFFF</Color>
          <Color x:Key="SurfaceHoverColor">#EEF1F4</Color>
          <Color x:Key="BorderColor">#D0D7DE</Color>
          <Color x:Key="TextColor">#1F2328</Color>
          <Color x:Key="MutedColor">#656D76</Color>
          <Color x:Key="AccentColor">#12A66D</Color>
          <Color x:Key="WarnColor">#B7791F</Color>
          <Color x:Key="GainColor">#12A66D</Color>
          <Color x:Key="LossColor">#E0405E</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <SolidColorBrush x:Key="WindowBgBrush" Color="{DynamicResource WindowBgColor}" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
      <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{DynamicResource SurfaceHoverColor}" />
      <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
      <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
      <SolidColorBrush x:Key="MutedBrush" Color="{DynamicResource MutedColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
      <SolidColorBrush x:Key="WarnBrush" Color="{DynamicResource WarnColor}" />
      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,14,0,6" />
  </Style>
  <Style Selector="TextBlock.warn">
    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
  </Style>
  <Style Selector="TextBlock.up">
    <Setter Property="Foreground" Value="{DynamicResource UpBrush}" />
  </Style>
  <Style Selector="TextBlock.down">
    <Setter Property="Foreground" Value="{DynamicResource DownBrush}" />
  </Style>

  <Style Selector="controls|SparklineControl">
    <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    <Setter Property="StoppedStroke" Value="{DynamicResource MutedBrush}" />
    <Setter Property="AboveStroke" Value="{DynamicResource UpBrush}" />
    <Setter Property="BelowStroke" Value="{DynamicResource DownBrush}" />
  </Style>
  <Style Selector="controls|SparklineControl.up">
    <Setter Property="Stroke" Value="{DynamicResource UpBrush}" />
  </Style>
  <Style Selector="controls|SparklineControl.down">
    <Setter Property="Stroke" Value="{DynamicResource DownBrush}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="Button.icon Path">
    <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Button.icon:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.icon.active Path">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button.status">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.status:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.status:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.status:flyout-open /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.status:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.link /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextBlock.TextDecorations" Value="Underline" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="Button.link:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="FlyoutPresenter.status">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="ToggleButton.disclosure">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ToggleButton.disclosure:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.disclosure:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.disclosure:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.disclosure:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Path.chevron">
    <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
  </Style>
  <Style Selector="Path.chevron.expanded">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>
  <Style Selector="ToggleButton.disclosure:pointerover Path.chevron">
    <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="#0B0D10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="4,1" />
  </Style>

  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Ellipse.dot.good">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Ellipse.dot.bad">
    <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
  </Style>

  <Style Selector="Border.row">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="UserControl.dragging Border.row">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Border.row.dimmed > Grid">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- Cards of the card layout. The size is fixed and set by the card size setting: small (the symbol and the price only),
       medium (the base style) and large (a taller chart and more figures). What the small card leaves out has the class
       "detail" and what only the large card shows has "largeonly"; the visibility is set here, never on the elements. -->
  <Style Selector="Border.tile">
    <Setter Property="Width" Value="176" />
    <Setter Property="Height" Value="96" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="Border.tile.small">
    <Setter Property="Width" Value="128" />
    <Setter Property="Height" Value="54" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="Border.tile.large">
    <Setter Property="Width" Value="264" />
    <Setter Property="Height" Value="176" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.tile Border.flash">
    <Setter Property="Margin" Value="-10,-8" />
  </Style>
  <Style Selector="Border.tile.small Border.flash">
    <Setter Property="Margin" Value="-10,-7" />
  </Style>
  <Style Selector="Border.tile.large Border.flash">
    <Setter Property="Margin" Value="-12,-10" />
  </Style>
  <Style Selector="Border.tile TextBlock.symbol">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Border.tile.large TextBlock.symbol">
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="Border.tile TextBlock.name">
    <Setter Property="FontSize" Value="10" />
  </Style>
  <Style Selector="Border.tile.large TextBlock.name">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Border.tile TextBlock.price">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Border.tile.large TextBlock.price">
    <Setter Property="FontSize" Value="22" />
  </Style>
  <Style Selector="Border.tile TextBlock.change">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Border.tile.large TextBlock.change">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <!-- The price takes the color of the move where the change is not shown beside it. -->
  <Style Selector="Border.tile.small TextBlock.price.tickup, Border.tile.large TextBlock.price.tickup">
    <Setter Property="Foreground" Value="{DynamicResource UpBrush}" />
  </Style>
  <Style Selector="Border.tile.small TextBlock.price.tickdown, Border.tile.large TextBlock.price.tickdown">
    <Setter Property="Foreground" Value="{DynamicResource DownBrush}" />
  </Style>
  <Style Selector="Border.tile controls|SparklineControl.chart">
    <Setter Property="MinHeight" Value="16" />
  </Style>
  <Style Selector="Border.tile.large controls|SparklineControl.chart">
    <Setter Property="MinHeight" Value="44" />
  </Style>
  <Style Selector="Border.tile:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="Border.tile.dimmed > Grid">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="Border.tile.small :is(Control).detail">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.tile:not(.large) :is(Control).largeonly">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="UserControl.dragging Border.tile">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
  </Style>

  <!-- The frame of the settings and add windows; it replaces the system title bar and matches the main window. -->
  <Style Selector="views|ToolWindowFrame">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border Background="{DynamicResource WindowBgBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="12" />
          <Grid RowDefinitions="Auto,*,Auto" Margin="1">
            <Border Name="PART_Header" Grid.Row="0" Background="Transparent" Padding="14,8,8,4">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Image Source="/Assets/fluxtick.png" Width="16" Height="16" />
                  <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <Button Name="PART_Close" Grid.Column="1" Classes="icon"
                        AutomationProperties.Name="{loc:T Common_Close}" ToolTip.Tip="{loc:T Common_CloseEsc}">
                  <Path Data="M3 3l8 8M11 3l-8 8" />
                </Button>
              </Grid>
            </Border>
            <ContentPresenter Grid.Row="1"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
            <!-- Its own row, so the grip never covers the content or its scroll bar. -->
            <Border Name="PART_Grip" Grid.Row="2" Width="16" Height="16" Margin="0,0,4,4"
                    HorizontalAlignment="Right"
                    Background="Transparent" Cursor="BottomRightCorner">
              <Path Data="M12 4L4 12M12 8l-4 4" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2" StrokeLineCap="Round" />
            </Border>
          </Grid>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="TabControl.settings">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TabControl.settings /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="Margin" Value="14,0" />
  </Style>
  <Style Selector="TabControl.settings > TabItem">
    <Setter Property="Padding" Value="12,6,12,8" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_LayoutRoot"
                Background="{TemplateBinding Background}"
                BorderBrush="Transparent"
                BorderThickness="0,0,0,2"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            RecognizesAccessKey="True" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TabControl.settings > TabItem:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TabControl.settings > TabItem:focus-visible /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="TabControl.settings > TabItem:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="TabControl.settings > TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TabControl.settings > TabItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
</Styles>
