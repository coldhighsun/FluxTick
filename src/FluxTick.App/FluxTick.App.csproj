<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>FluxTick</AssemblyName>
    <RootNamespace>FluxTick.App</RootNamespace>
    <Description>A lightweight, open-source desktop widget for tracking multiple financial markets at a glance.</Description>
    <ApplicationIcon>Assets\fluxtick.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
    <!-- The release workflow sets this. Only official builds look for updates by themselves: the version of any other
         build, such as one from a commit after the last tag, is below every release. -->
    <OfficialBuild Condition="'$(OfficialBuild)' == ''">false</OfficialBuild>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OfficialBuild</_Parameter1>
      <_Parameter2>$(OfficialBuild)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\Strings\*.json" LogicalName="FluxTick.Strings.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="GitHubReleaseUpdater" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="MinVer" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxTick.Core\FluxTick.Core.csproj" />
    <ProjectReference Include="..\FluxTick.Providers.Common\FluxTick.Providers.Common.csproj" />
    <ProjectReference Include="..\FluxTick.Providers.Binance\FluxTick.Providers.Binance.csproj" />
    <ProjectReference Include="..\FluxTick.Providers.Yahoo\FluxTick.Providers.Yahoo.csproj" />
    <ProjectReference Include="..\FluxTick.Providers.Tencent\FluxTick.Providers.Tencent.csproj" />
    <ProjectReference Include="..\FluxTick.Providers.Sina\FluxTick.Providers.Sina.csproj" />
    <ProjectReference Include="..\FluxTick.Providers.Okx\FluxTick.Providers.Okx.csproj" />
    <ProjectReference Include="..\FluxTick.Providers.Coinbase\FluxTick.Providers.Coinbase.csproj" />
    <ProjectReference Include="..\FluxTick.Providers.Kraken\FluxTick.Providers.Kraken.csproj" />
    <ProjectReference Include="..\FluxTick.Providers.Bybit\FluxTick.Providers.Bybit.csproj" />
    <ProjectReference Include="..\FluxTick.Providers.Simulated\FluxTick.Providers.Simulated.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FluxTick.App.Tests" />
  </ItemGroup>

</Project>
