<?xml version="1.0" encoding="utf-8"?>
<!--
  Code coverage settings, passed to dotnet test through the coverage-settings option.
  Avalonia 12.2 compiles XAML into generated types and methods (CompiledAvaloniaXaml.XamlIlHelpers and
  nested view types) whose names contain control characters such as 0x01, in our assemblies as well as
  in Avalonia's own. They are not valid XML, so the Cobertura writer crashes on them. Leave them out.
-->
<Configuration>
  <CodeCoverage>
    <Functions>
      <Exclude>
        <Function>.*[\x01-\x08\x0B\x0C\x0E-\x1F].*</Function>
      </Exclude>
    </Functions>
  </CodeCoverage>
</Configuration>
